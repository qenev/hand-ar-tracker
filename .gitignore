.ruff_cache/
vulture_report.txt
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's system. But for a desktop/web application, you might
#   want to check them in.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms, it could be harmful.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains system-specific information and should be ignored
#   if not desired.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains system-specific information and should be ignored
#   if not desired.
# pdm.lock

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

